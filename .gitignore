# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.eggs/
build/
dist/
.tox/

# Virtual envs (anchored to repo root so we don't catch src/rlbot/env/)
/.venv/
/venv/
/env/
/ENV/

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Project artifacts (keep folders via .gitkeep)
data/*
!data/.gitkeep
checkpoints/*
!checkpoints/.gitkeep
logs/*
!logs/.gitkeep
runs/
wandb/
*.pt
*.ckpt
*.onnx
# Exception: the deployment bot bundles its policy weights so it can play on any
# machine. These MUST be tracked despite the *.pt rule above.
!rl-bot/src/policy/weights/PPO_POLICY.pt

# Rocket League / RLGym specific
collision_meshes/
rlbot.cfg.local
*.log
rlviser*
*.dll
# rlviser writes its own UI config to settings.txt on first launch
settings.txt

# Secrets
.env
.env.local
*.key
secrets.yaml

# Notebooks
.ipynb_checkpoints/
notebooks/*.ipynb
!notebooks/.gitkeep

# Coverage / reports
htmlcov/
.coverage
coverage.xml
*.cover
